# Wayfinder Guild production environment example.
# Copy values into your server-side environment manager. Do not commit real secrets.

# Backend runtime
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8123
WAYFINDER_DEMO_ENABLED=true
WAYFINDER_OWNER_TOKEN=replace-with-a-long-random-secret
TRAVEL_RAG_MODE=demo
WAYFINDER_CORS_ALLOWED_ORIGIN_PATTERNS=https://your-domain.example
SPRINGDOC_API_DOCS_ENABLED=false
SPRINGDOC_SWAGGER_UI_ENABLED=false
KNIFE4J_ENABLE=false

# DeepSeek / OpenAI-compatible Spring AI settings.
# Leave DEEPSEEK_API_KEY empty for public Demo Mode; set it only for Owner Live model calls.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-chat

# Optional PostgreSQL / PgVector settings.
# Leave these empty for public demo/lightweight RAG.
# Set TRAVEL_RAG_MODE=pgvector only for local or Owner Live demos.
DB_URL=jdbc:postgresql://127.0.0.1:5432/sy_ai_agent
DB_USERNAME=sy_ai_agent
DB_PASSWORD=

# Optional tool keys
SEARCH_PROVIDER=disabled
TAVILY_API_KEY=
PEXELS_API_KEY=
AMAP_MAPS_API_KEY=

# Production logging overrides
LOGGING_LEVEL_ORG_SPRINGFRAMEWORK_AI=INFO
LOGGING_LEVEL_COM_SEEWHY_SYAIAGENT=INFO

# Frontend build
# Use /api when Nginx serves the frontend and reverse proxies /api to Spring Boot.
VITE_API_BASE=/api
